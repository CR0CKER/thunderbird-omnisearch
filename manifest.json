{
  "manifest_version": 3,
  "name": "OmniSearch for Thunderbird",
  "version": "0.7.0",
  "description": "Fast, fuzzy, relevance-ranked email search powered by MiniSearch. Maintains its own index, independent of Thunderbird's Gloda.",
  "author": "CR0CKER",
  "homepage_url": "https://github.com/CR0CKER/thunderbird-omnisearch",
  "browser_specific_settings": {
    "gecko": {
      "id": "omnisearch@cr0cker.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "lib/extract.js",
      "lib/indexer.js",
      "lib/events.js",
      "lib/open.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "OmniSearch",
    "default_popup": "ui/search.html",
    "default_icon": "icons/search.svg"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Open OmniSearch"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/omnisearch.svg",
    "32": "icons/omnisearch.svg",
    "48": "icons/omnisearch.svg",
    "64": "icons/omnisearch.svg",
    "128": "icons/omnisearch.svg"
  }
}
